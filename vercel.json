{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{src/server/**,src/lib/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|Dokumentasi_RDBMS_Bukit_Randu\\.pdf).*)",
      "destination": "/api/index"
    }
  ]
}
