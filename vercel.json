{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/Dokumentasi_RDBMS_Bukit_Randu.pdf",
      "dest": "/public/Dokumentasi_RDBMS_Bukit_Randu.pdf"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
