<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Lewati rewrite jika file atau direktori fisik benar-benar ada (mis. gambar /assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan seluruh permintaan URL bersih ke Front-Controller public/index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
