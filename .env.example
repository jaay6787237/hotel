# =====================================================================
# BUKIT RANDU HOSPITALITY - KONFIGURASI LINGKUNGAN (SUPABASE & VERCEL)
# Salin file ini menjadi .env untuk penggunaan lokal
# atau tambahkan ke Environment Variables di Dashboard Vercel.
# =====================================================================

# OPSI 1 (DIREKOMENDASIKAN UNTUK VERCEL + SUPABASE):
# Ambil dari Supabase Dashboard -> Connect -> Transaction Pooler (port 6543) atau Session Pooler (port 5432)
DATABASE_URL=postgresql://postgres.your-project-id:your-supabase-database-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# OPSI 2 (Alternatif variabel terpisah jika tidak memakai DATABASE_URL):
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASS=your-supabase-database-password

# Kunci rahasia aplikasi untuk penandatanganan Cookie HTTP-Only HMAC SHA-256
# Ganti dengan string acak panjang minimal 32 karakter saat produksi
APP_KEY=bukit-randu-hospitality-lampung-secret-key-2026-hmac

# Kredensial Portal Admin / Resepsionis Front Office
ADMIN_USER=admin@bukitrandu.com
ADMIN_PASS=BukitRandu2026!
